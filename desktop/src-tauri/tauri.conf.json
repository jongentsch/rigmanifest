{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RigManifest",
  "version": "0.1.5",
  "identifier": "com.jongentsch.rigmanifest",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "RigManifest",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY5N0VDQ0I1NjkyMjI1ODgKUldTSUpTSnB0Y3grYVlVaWhweWRnKzRUT0FOSFBvYXNaYnZyWE5Ia2FQdGYzOHFLeUdpeW5NMUcK",
      "endpoints": [
        "https://github.com/jongentsch/rigmanifest/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
